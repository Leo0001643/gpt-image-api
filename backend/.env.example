# GPT Image API Backend 环境变量样例（生产/预发请通过 KMS / Secret 注入，不要 commit）
# 复制为 .env.local（已 gitignore）后修改

# 运行环境
GIA_ENV=dev                      # local | dev | staging | prod

# 监听端口（参考 docs/01 - 端口规范）
GIA_API_PORT=17180
GIA_ADMIN_PORT=17188
GIA_OPENAI_PORT=17200
GIA_WS_PORT=17280
GIA_PPROF_PORT=17590

# 数据库（MySQL 13306）
GIA_DB_DSN=gia:gia123@tcp(127.0.0.1:13306)/gpt_image_api?charset=utf8mb4&parseTime=True&loc=Local

# 远程运维账号（由 deploy/mysql-init/02-create-remote-user.sh 初始化，仅 DML 权限）
# 留空则不创建；用 Navicat / DBeaver 等工具连接 13306 端口
GIA_DB_OPS_USER=giaops
GIA_DB_OPS_PASSWORD=replace_me_with_ops_pwd

# Redis（16379）
GIA_REDIS_ADDR=127.0.0.1:16379
GIA_REDIS_PASSWORD=
GIA_REDIS_DB=0

# JWT（≥ 32 字节，生产请用 openssl rand -hex 32 重新生成）
GIA_JWT_SECRET=please-change-me-32bytes-min-secret-xx
GIA_JWT_REFRESH_SECRET=please-change-me-32bytes-min-refresh-xx
GIA_JWT_ACCESS_TTL=2h
GIA_JWT_REFRESH_TTL=336h

# 加密账号池凭证（AES-256-GCM）
GIA_AES_KEY=00000000000000000000000000000000  # 32 字节 hex / base64

# 第三方 Provider 默认 base
GIA_OPENAI_BASE=https://api.openai.com
GIA_GROK_BASE=https://api.x.ai

# Provider 模式：mock（本地默认）| real（生产开启真实 HTTP 调用）
GIA_PROVIDER_GPT=mock
GIA_PROVIDER_GROK=mock
# 真实模式下的默认 base url（账号未单独配置时使用）
GIA_GPT_BASE_URL=https://api.openai.com
GIA_GROK_BASE_URL=https://api.x.ai

# 雪花机器 ID（多副本部署需保证不同）
GIA_NODE_ID=1

# 日志
GIA_LOG_LEVEL=info
GIA_LOG_DIR=./logs
GIA_LOG_MAX_SIZE_MB=200
GIA_LOG_MAX_AGE_DAYS=30
GIA_LOG_COMPRESS=true

# CORS 白名单（逗号分隔）
GIA_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://gpt-image-api.example,https://admin.gpt-image-api.example
