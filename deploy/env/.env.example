# ================================================================
#  GPT Image API · 生产环境配置模板
#  用法：cp .env.example .env.local  然后逐项填写
#  安全：.env.local 禁止提交到 git
# ================================================================

# ── 运行环境 ────────────────────────────────────────────────────
GIA_ENV=prod

# ── 对外端口（按需修改） ──────────────────────────────────────
GIA_ADMIN_WEB_PORT=17080
GIA_USER_WEB_PORT=17088
GIA_OPENAI_PORT=17200

# ── MySQL ───────────────────────────────────────────────────────
GIA_MYSQL_PORT=33306
GIA_MYSQL_DB=gpt_image_api
GIA_MYSQL_USER=gia
GIA_MYSQL_PASSWORD=replace_with_strong_password
GIA_MYSQL_ROOT_PASSWORD=replace_with_strong_root_password
# DSN 需与上方 USER/PASSWORD/DB 保持一致
GIA_DB_DSN=gia:replace_with_strong_password@tcp(mysql:3306)/gpt_image_api?charset=utf8mb4&parseTime=True&loc=Local

# ── Redis ───────────────────────────────────────────────────────
GIA_REDIS_PORT=16379
GIA_REDIS_ADDR=redis:6379
GIA_REDIS_PASSWORD=

# ── 安全密钥（生成：openssl rand -hex 32） ───────────────────────
GIA_JWT_SECRET=
GIA_JWT_REFRESH_SECRET=
GIA_AES_KEY=

# ── Provider ────────────────────────────────────────────────────
# real = 调用真实 API | mock = 本地假数据（仅开发测试）
GIA_PROVIDER_GPT=real
GIA_PROVIDER_GROK=real
# 自定义代理地址（留空则使用官方地址）
GIA_OPENAI_BASE=https://api.openai.com
GIA_GROK_BASE=https://api.x.ai

# ── 跨域 ────────────────────────────────────────────────────────
# 有域名填域名；纯 IP 访问填 http://IP:端口，多个用逗号分隔
GIA_CORS_ORIGINS=http://your-server-ip:17080,http://your-server-ip:17088

# ── 远程运维账号（仅 DML 权限，Navicat/DBeaver 可用） ────────────
# 留空则不创建；密码须 >= 12 位
GIA_DB_OPS_USER=giaops
GIA_DB_OPS_PASSWORD=
