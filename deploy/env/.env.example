# ==============================================
#   GPT Image API 部署环境变量样例
#   生产请通过 KMS 注入，禁止 commit 实际值
# ==============================================

# 全局
GIA_ENV=prod

# 端口（仅修改对外）
GIA_USER_WEB_PORT=17080
GIA_ADMIN_WEB_PORT=17088
GIA_OPENAI_PORT=17200

# 内部端口（默认无需改）
GIA_API_PORT=17180
GIA_ADMIN_PORT=17188
GIA_WS_PORT=17280
GIA_PPROF_PORT=17590

# MySQL
GIA_MYSQL_PORT=23306
GIA_MYSQL_ROOT_PASSWORD=replace_me_with_strong_pwd
GIA_MYSQL_DB=gpt_image_api
GIA_MYSQL_USER=gia
GIA_MYSQL_PASSWORD=replace_me_with_strong_pwd
GIA_DB_DSN=gia:replace_me_with_strong_pwd@tcp(mysql:3306)/gpt_image_api?charset=utf8mb4&parseTime=True&loc=Local

# 远程运维账号（仅 DML 权限，可用 Navicat/DBeaver 等工具远程连接）
# 留空则不创建该账号；密码须 >= 12 位
GIA_DB_OPS_USER=giaops
GIA_DB_OPS_PASSWORD=replace_me_with_ops_pwd

# Redis
GIA_REDIS_PORT=16379
GIA_REDIS_ADDR=redis:6379
GIA_REDIS_PASSWORD=

# 安全
GIA_JWT_SECRET=$(openssl rand -hex 32)
GIA_JWT_REFRESH_SECRET=$(openssl rand -hex 32)
GIA_AES_KEY=$(openssl rand -hex 32)

# Provider
GIA_OPENAI_BASE=https://api.openai.com
GIA_GROK_BASE=https://api.x.ai

# 跨域
# 有域名时填域名；纯 IP 访问时填 http://服务器IP:端口
GIA_CORS_ORIGINS=http://1.2.3.4:17080,http://1.2.3.4:17088

# 日志
GIA_LOG_DIR=/data/gia/logs
